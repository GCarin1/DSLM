{
  "$comment": "doctrina verify runs each check in order. The first three are documentation gates; host-test and nds-build run in the Docker image (docs/building.md); the parity tests join here in M3.",
  "checks": [
    {
      "name": "clarify",
      "run": "npx doctrina clarify --all",
      "expect": {
        "require_output_matches": "no smells"
      }
    },
    {
      "name": "trace",
      "run": "npx doctrina trace --strict",
      "expect": {
        "require_output_matches": "intent anchors realized"
      }
    },
    {
      "name": "links",
      "run": "python3 tests/check_links.py || python tests/check_links.py",
      "expect": {
        "require_output_matches": "links ok"
      }
    },
    {
      "name": "host-test",
      "run": "docker compose -f docker/docker-compose.yml run --rm test",
      "expect": {
        "require_output_matches": "all ini tests passed"
      }
    },
    {
      "name": "nds-build",
      "run": "docker compose -f docker/docker-compose.yml run --rm shell bash -c \"make nds && test -s dslm.nds && echo nds ok\"",
      "expect": {
        "require_output_matches": "nds ok"
      }
    }
  ]
}
